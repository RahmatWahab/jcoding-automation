<?xml version="1.0" encoding="UTF-8"?>
<!--
  Console logging for jcoding-automation. Output goes to stdout so the
  run_once.sh `tee` continues to capture a timestamped run log. Timestamps are
  UTC ISO-8601 to match the controller's internal time semantics.
-->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC} %-5level %logger{0} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Default level; override with -Dlog.level=DEBUG for verbose runs. -->
  <root level="${log.level:-INFO}">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
